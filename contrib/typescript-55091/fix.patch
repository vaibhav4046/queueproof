 })(E || (E = {}));
 const a = E.B;
 const b = E.A;
 var F;
 (function (F) {
-    F[F["X"] = NaN] = "X";
+    F[F["X"] = 0 / 0] = "X";
 })(F || (F = {}));
 const c = F.X; // Error expected - different enums
