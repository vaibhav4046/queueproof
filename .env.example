# Runtime cryptography: 32 random bytes, base64 encoded. Required before storing credentials.
QUEUEPROOF_ENCRYPTION_KEY=

# HydraDB credentials are sent only to this server-approved HTTPS origin.
# Leave the official API origin unchanged unless the deployment operator owns an alternative.
QUEUEPROOF_HYDRADB_BASE_URL=https://api.hydradb.com

# Storage: use hosted Turso in deployment or an explicit SQLite file in local development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
QUEUEPROOF_SQLITE_PATH=.data/queueproof.db

# Local identity is ignored in production even if accidentally set there.
QUEUEPROOF_ALLOW_LOCAL_IDENTITY=true

# Supabase passwordless authentication. Only the project URL and publishable browser key belong
# here; never use or expose a service_role key. The branded form stays on the QueueProof domain.
# A complete production pair defaults to supabase/false. Hybrid remains a development migration
# mode, while explicit production hybrid/legacy or legacy=true settings fail closed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
QUEUEPROOF_AUTH_MODE=hybrid
QUEUEPROOF_LEGACY_OWNER_SIGNIN=true

# Optional hosted sign-in shared secret and optional provider-write credential.
QUEUEPROOF_ACCESS_TOKEN=
# Separate 32+ character credential used only by the release benchmark publisher.
QUEUEPROOF_BENCHMARK_TOKEN=
LINEAR_API_KEY=
# Required with LINEAR_API_KEY. The global legacy credential executes only for this
# exact workspace and only when the deployment-owner actor records approval.
QUEUEPROOF_LINEAR_EXECUTION_WORKSPACE_ID=
# Placeholder only. Rotate the previously exposed credential before adding a new value.
ATTIO_ACCESS_TOKEN=

# Deliberately public mode: every anonymous visitor shares the bounded demo workspace.
# Public ask/queue activity records receipts; credentials and the control plane remain owner-only.
# Leave false/empty for the normal signed-session boundary.
QUEUEPROOF_PUBLIC_ACCESS=false
# Required when public access is true. The selected existing workspace must first receive an
# explicit, non-owner user:public-access membership via `pnpm public:provision`; there is no
# singleton fallback and request handling never creates this membership.
QUEUEPROOF_PUBLIC_WORKSPACE_ID=

# Opaque-token MCP is disabled unless both compatibility values are present.
QUEUEPROOF_MCP_TOKEN=
QUEUEPROOF_MCP_WORKSPACE_ID=

# MCP resource authentication is separate from web sign-in. Production MCP defaults to hybrid
# when the complete Supabase pair is present. Set opaque to pause OAuth, or supabase after retiring
# legacy MCP bearer tokens.
QUEUEPROOF_MCP_AUTH_MODE=hybrid
QUEUEPROOF_MCP_RESOURCE=https://queueproof.vercel.app/mcp

# Set temporarily to the exact token issued by the OpenAI plugin submission portal.
# The public verification route returns only this value and disables caching.
OPENAI_APPS_CHALLENGE=

# Set only when an upstream gateway injects and strips its authenticated identity headers.
# Never set openai-sites on a direct Vercel deployment; production validation rejects it.
QUEUEPROOF_TRUSTED_IDENTITY_PROXY=

# Never enable fixture mode in a production deployment.
QUEUEPROOF_TEST_MODE=false
QUEUEPROOF_LIVE_TEST=false
QUEUEPROOF_URL=http://127.0.0.1:3000

# Used by the explicit live-acceptance script only. Prefer entering this in the web UI.
# HydraDB's current SDK and docs use this underscore-separated name.
HYDRA_DB_API_KEY=
QUEUEPROOF_DATABASE=queueproof-live
