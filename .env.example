# Runtime cryptography: 32 random bytes, base64 encoded. Required before storing credentials.
QUEUEPROOF_ENCRYPTION_KEY=

# Remote MCP is disabled unless both values are present.
QUEUEPROOF_MCP_TOKEN=
QUEUEPROOF_MCP_WORKSPACE_ID=

# Optional OAuth issuer. Omit to keep OAuth metadata disabled.
QUEUEPROOF_OAUTH_ISSUER=

# Never enable fixture mode in a production deployment.
QUEUEPROOF_TEST_MODE=false
QUEUEPROOF_LIVE_TEST=false
QUEUEPROOF_URL=http://127.0.0.1:3000

# Used by the explicit live-acceptance script only. Prefer entering this in the web UI.
HYDRADB_API_KEY=
